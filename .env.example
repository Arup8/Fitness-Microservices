# Set these as environment variables (IntelliJ: Run Configuration > Environment variables).
# Never commit real values.

# configserver (served to user-service)
USER_DB_URL=jdbc:postgresql://<host>:<port>/fitness_micro_user
USER_DB_USERNAME=<username>
USER_DB_PASSWORD=<password>

# configserver (served to activity-service / ai-service) and aiservice
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>

# aiservice
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_KEY=<your-gemini-key>
GEMINI_MODEL=<model-name>

# docker-compose only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<choose-a-strong-password>
# Frontend URL(s) allowed by the gateway CORS (comma-separated). Default: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
